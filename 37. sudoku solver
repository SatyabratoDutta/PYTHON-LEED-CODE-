class Solution:
    def solveSudoku(self, board):
        rows = [set() for _ in range(9)]
        cols = [set() for _ in range(9)]
        boxes = [set() for _ in range(9)]
        empty = []

        for r in range(9):
            for c in range(9):
                if board[r][c] == ".":
                    empty.append((r, c))
                else:
                    num = board[r][c]
                    rows[r].add(num)
                    cols[c].add(num)
                    boxes[(r // 3) * 3 + c // 3].add(num)

        def backtrack(pos):
            if pos == len(empty):
                return True

            best = pos
            min_options = 10

            for i in range(pos, len(empty)):
                r, c = empty[i]
                box = (r // 3) * 3 + c // 3
                options = {
                    str(d) for d in range(1, 10)
                    if str(d) not in rows[r]
                    and str(d) not in cols[c]
                    and str(d) not in boxes[box]
                }

                if len(options) < min_options:
                    min_options = len(options)
                    best = i

                if min_options == 1:
                    break

            if min_options == 0:
                return False

            empty[pos], empty[best] = empty[best], empty[pos]
            r, c = empty[pos]
            box = (r // 3) * 3 + c // 3

            for d in range(1, 10):
                num = str(d)

                if (num not in rows[r]
                    and num not in cols[c]
                    and num not in boxes[box]):

                    board[r][c] = num
                    rows[r].add(num)
                    cols[c].add(num)
                    boxes[box].add(num)

                    if backtrack(pos + 1):
                        return True

                    board[r][c] = "."
                    rows[r].remove(num)
                    cols[c].remove(num)
                    boxes[box].remove(num)

            empty[pos], empty[best] = empty[best], empty[pos]
            return False

        backtrack(0)
        

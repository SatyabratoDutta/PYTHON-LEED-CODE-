class Solution(object):

    def reverse(self, x):
        """
        :type x: int
        :rtype: int
        """

        sign = -1 if x < 0 else 1
        x = abs(x)

        rev = 0

        while x != 0:
            digit = x % 10
            x = x // 10

            # Check for 32-bit integer overflow
            if rev > (2**31 - 1 - digit) // 10:
                return 0

            rev = rev * 10 + digit

        return sign * rev

class Solution:
    def minWindow(self, s, t):
        from collections import Counter

        need = Counter(t)
        left = 0
        required = len(t)
        min_len = float('inf')
        start = 0

        for right, char in enumerate(s):
            if need[char] > 0:
                required -= 1

            need[char] -= 1

            while required == 0:
                if right - left + 1 < min_len:
                    min_len = right - left + 1
                    start = left

                need[s[left]] += 1

                if need[s[left]] > 0:
                    required += 1

                left += 1

        if min_len == float('inf'):
            return ""

        return s[start:start + min_len]

class Solution(object):

    def isPalindrome(self, x):
        """
        :type x: int
        :rtype: bool
        """

        # Negative numbers are not palindromes
        if x < 0:
            return False

        # Numbers ending in 0 are not palindromes
        # except 0 itself
        if x != 0 and x % 10 == 0:
            return False

        original = x
        reverse = 0

        # Reverse the integer
        while x > 0:
            digit = x % 10
            reverse = reverse * 10 + digit
            x = x // 10

        return original == reverse

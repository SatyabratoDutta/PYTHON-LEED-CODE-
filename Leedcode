14. Fizz Buzz — LeetCode #412
class Solution:
    def fizzBuzz(self, n):
        result = []

        for i in range(1, n + 1):
            if i % 15 == 0:
                result.append("FizzBuzz")
            elif i % 3 == 0:
                result.append("Fizz")
            elif i % 5 == 0:
                result.append("Buzz")
            else:
                result.append(str(i))

        return result
Example: n = 5
Output: ["1","2","Fizz","4","Buzz"]





15. Single Number — LeetCode #136
class Solution:
    def singleNumber(self, nums):
        result = 0

        for num in nums:
            result ^= num

        return result
Example:
Input: [4, 1, 2, 1, 2]
Output: 4
Time: O(n)
Space: O(1)





16. Climbing Stairs — LeetCode #70
class Solution:
    def climbStairs(self, n):
        if n <= 2:
            return n

        a = 1
        b = 2

        for i in range(3, n + 1):
            a, b = b, a + b

        return b
Example:
Input: 5
Output: 8
Time: O(n)
Space: O(1)





17. Majority Element — LeetCode #169
class Solution:
    def majorityElement(self, nums):
        count = 0
        candidate = None

        for num in nums:
            if count == 0:
                candidate = num

            if num == candidate:
                count += 1
            else:
                count -= 1

        return candidate
Example:
Input: [2,2,1,1,1,2,2]
Output: 2
Time: O(n)
Space: O(1)





18. Intersection of Two Arrays II — LeetCode #350
class Solution:
    def intersect(self, nums1, nums2):
        from collections import Counter

        count = Counter(nums1)
        result = []

        for num in nums2:
            if count[num] > 0:
                result.append(num)
                count[num] -= 1

        return result
Example:
Input: nums1 = [1,2,2,1], nums2 = [2,2]
Output: [2,2]
Time: O(n + m)
Space: O(n)





19. Merge Sorted Array — LeetCode #88
class Solution:
    def merge(self, nums1, m, nums2, n):
        i = m - 1
        j = n - 1
        k = m + n - 1

        while j >= 0:
            if i >= 0 and nums1[i] > nums2[j]:
                nums1[k] = nums1[i]
                i -= 1
            else:
                nums1[k] = nums2[j]
                j -= 1

            k -= 1
Example:
nums1 = [1,2,3,0,0,0]
nums2 = [2,5,6]
Output:
[1,2,2,3,5,6]
Time: O(m+n)
Space: O(1)




20. Length of Last Word — LeetCode #58
class Solution:
    def lengthOfLastWord(self, s):
        words = s.split()
        return len(words[-1])
Example:
Input: "Hello World"
Output: 5
Time: O(n)
Space: O(n)
